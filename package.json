{
  "name": "0identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26.5.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:ai": "vite --mode ai --host 127.0.0.1",
    "build": "vite build",
    "build:local": "vite build --mode offline",
    "preview": "npm run build:local && vite preview --mode offline --host 127.0.0.1",
    "preview:ai": "npm run build && vite preview --mode ai --host 127.0.0.1",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "cf-typegen": "wrangler types",
    "typecheck": "npm run cf-typegen && tsc -p tsconfig.web.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.110",
    "@cloudflare/ai-chat": "^0.12.0",
    "@gsap/react": "^2.1.2",
    "agents": "^0.24.0",
    "ai": "^7.0.107",
    "gsap": "^3.15.0",
    "jose": "6.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "workers-ai-provider": "^4.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.56.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "^30.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.135.0"
  }
}
